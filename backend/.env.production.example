# Copy to backend/.env on the deployment host; never commit real credentials.
NODE_ENV=production
HOST=0.0.0.0
PORT=4300
SERVE_WEB=false
API_BASE_URL=https://shop.example.com
# https://localhost is the Sureshot Android/iOS app (Capacitor) origin.
CORS_ORIGINS=https://shop.example.com,https://localhost

# ---- Reverse proxy -------------------------------------------------------------------
# Number of proxy hops in front of the API (nginx = 1, nginx behind a cloud LB = 2).
# Without this every user looks like the proxy IP and shares ONE rate-limit bucket.
TRUST_PROXY=1

# ---- Scale ---------------------------------------------------------------------------
# Redis shares the cache, rate limits and Socket.IO rooms between every API process.
RATE_LIMIT_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SOCKET_REDIS_ADAPTER=true
# API processes per container/host (npm run start:cluster). Default: min(cores, 4).
WEB_CONCURRENCY=4
# Connections per process. Total = DB_POOL_MAX x WEB_CONCURRENCY x instances must stay
# below Postgres max_connections (use PgBouncer for large fleets).
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Password hashes running at once per process (login surge protection).
PASSWORD_HASH_CONCURRENCY=4
# Per-IP ceilings are generous on purpose: many phones share one carrier NAT address.
RATE_LIMIT_IP_PER_5MIN=3000
RATE_LIMIT_USER_PER_5MIN=900

# ---- Database ------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sureshot
DB_USER=sureshot_app
DB_PASSWORD=
# DB_SSL=true

# ---- Secrets (generate unique values) ------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
LOG_LEVEL=info
# OTP delivery returns 503 in production until an SMS/email provider is configured; password sign-in works without it.
# Configure storage, online payments and couriers from .env.example as needed.
