# Copy to .env.app — used by `npm run app:build` (vite --mode app).
# The app is served from https://localhost inside the phone, so the API URL
# must be absolute.
#
# Android emulator against the local dev API (also set SURESHOT_DEV_API=1):
VITE_API_BASE_URL=http://10.0.2.2:4300/api/v1
#
# Release build: your live https API, e.g.
# VITE_API_BASE_URL=https://api.sureshot.in/api/v1
